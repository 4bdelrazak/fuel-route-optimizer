# Copy to .env and adjust. Never commit .env.

# --- Django ---------------------------------------------------------------
# Required when DJANGO_DEBUG is false. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_PATH=db.sqlite3
LOG_LEVEL=INFO
# Requests per minute per client IP for the optimize endpoint.
API_RATE_LIMIT=60/min

# --- Vehicle --------------------------------------------------------------
# The assignment fixes these; they are configurable so the maths can be tested
# against other vehicles.
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_FUEL_ECONOMY_MPG=10

# --- Fuel stop search -----------------------------------------------------
# How far off the route a station may sit and still be a candidate. Wide because
# stations are placed at their city's centroid (see README, "Design decisions").
STATION_CORRIDOR_MILES=25
# The departure tank is priced from the cheapest station within this many route
# miles of the start.
START_FILL_WINDOW_MILES=50
# Candidates are thinned to the cheapest station per this many route miles.
STATION_POSITION_BUCKET_MILES=5

# --- Routing (OSRM) -------------------------------------------------------
# The public demo server is rate limited and offers no uptime guarantee. Point
# this at your own OSRM instance for anything beyond a demo.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=15

# --- Geocoding (Nominatim) ------------------------------------------------
# Nominatim's usage policy requires a User-Agent identifying your application.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=fuel-route-optimizer/1.0 (you@example.com)
NOMINATIM_TIMEOUT_SECONDS=10

# --- Caching --------------------------------------------------------------
GEOCODE_CACHE_SECONDS=2592000
ROUTE_CACHE_SECONDS=604800
